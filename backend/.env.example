# Copy to backend/.env and fill in.
# Generate a key: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*
# Optional, comma-separated. If empty, all origins are allowed (auth uses Bearer tokens, not cookies).
CORS_ALLOWED_ORIGINS=
# Optional, comma-separated. Defaults to the Render + Railway backend URLs.
# CSRF_TRUSTED_ORIGINS=https://your-backend.example.com

# Any OpenAI-compatible API. Defaults to Groq.
OPENAI_API_KEY=your-groq-api-key
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b
# Used for messages that include images (must accept image input).
OPENAI_VISION_MODEL=qwen/qwen3.8-27b
# Where uploaded attachments are stored (defaults to backend/media).
# MEDIA_ROOT=/data/media
